    },
    {
      "parameters": {
        "jsCode": "\nconst data = $input.first().json;\n\n// Get the extracted book titles and links\nconst titles = data.bookTitles || [];\nconst links = data.bookLinks || [];\n\n// Combine each title with its corresponding link\nconst books = titles.map((title, index) => {\n  const link = links[index];\n\n  return {\n    title: title,\n    url: link\n      ? 'https://books.toscrape.com/' + link\n      : null\n  };\n});\n\n// Return one item containing all books\nreturn [{\n  json: {\n    totalBooks: books.length,\n    books: books\n  }\n}];\n"
      },
